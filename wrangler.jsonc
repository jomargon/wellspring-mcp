/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The top-level target serves `wrangler dev` locally and self-hosted
	// instances (`npm run deploy` → <name>.<subdomain>.workers.dev, README
	// §Self-hosting). Self-hosters: change `name`, `PUBLIC_ORIGIN`, and the KV
	// namespace ids below to your own.
	//
	// The operator's production instance is the `production` env at the bottom
	// of this file, deployed only by CI on merge to main. There is no deployed
	// dev environment.
	"name": "wellspring-mcp-local",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Commands to set secrets:
	 * npx wrangler secret put WITHINGS_CLIENT_ID
	 * npx wrangler secret put WITHINGS_CLIENT_SECRET
	 * npx wrangler secret put TOKEN_ENCRYPTION_KEY
	 * npx wrangler secret put COOKIE_ENCRYPTION_KEY
	 */
	// Bundle the favicon SVG as a text module (single source of truth: the
	// repo-root icon.svg, also used for the Withings app registration).
	"rules": [{ "type": "Text", "globs": ["**/*.svg"] }],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["UserTokensDO"],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "UserTokensDO",
				"name": "USER_TOKENS"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "54f3aff8638c46dca478d99b57433c9f"
		}
	],
	"observability": {
		"enabled": true
	},
	// Per-IP rate limiting on the auth routes (PLAN.md §7). Workers Rate
	// Limiting API — free plan, open beta. namespace_id is an arbitrary
	// account-unique positive integer.
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	// Non-secret config: public origin used to build the connector URL on the
	// landing page and re-auth links in tool errors (the MCP layer has no
	// request URL to derive it from).
	//
	// Defaults to the local dev server; production overrides it below, and
	// self-hosters must set it to their own worker URL or the connector and
	// re-auth links will point at localhost.
	//
	// The Withings OAuth hop cannot complete against localhost: Withings
	// exact-matches the registered redirect URI, so the hop is only testable
	// against a deployed origin. Everything else runs fine locally.
	"vars": {
		"PUBLIC_ORIGIN": "http://localhost:8788"
	},
	"dev": {
		"port": 8788
	},
	"env": {
		// Bindings are not inherited by named environments, so they're mirrored
		// here. First deploy is manual (npm run deploy:production); after that,
		// CI deploys on merge to main.
		"production": {
			"name": "wellspring-mcp",
			"routes": [
				{
					"pattern": "wellspring.fit",
					"custom_domain": true
				}
			],
			// The custom domain is the only origin: no workers.dev hostname, no
			// preview URLs. A second origin would break PUBLIC_ORIGIN, cookies,
			// and OAuth redirect assumptions.
			"workers_dev": false,
			"preview_urls": false,
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MyMCP",
						"name": "MCP_OBJECT"
					},
					{
						"class_name": "UserTokensDO",
						"name": "USER_TOKENS"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "cc1a5f21aaa54886a70702954c379a27"
				}
			],
			"ratelimits": [
				{
					"name": "AUTH_RATE_LIMIT",
					"namespace_id": "1001",
					"simple": {
						"limit": 10,
						"period": 60
					}
				}
			],
			"vars": {
				"PUBLIC_ORIGIN": "https://wellspring.fit"
			}
		}
	}
}
